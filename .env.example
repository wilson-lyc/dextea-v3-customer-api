# 应用
PORT=8080
# 运行环境：development | test | production
ENVIRONMENT=development
# 服务名
SERVICE_NAME=dextea-customer-api

# MySQL（必填：DB_HOST / DB_USER / DB_NAME）
DB_HOST=
DB_USER=
DB_NAME=
# DB_PORT=3306
# DB_PASSWORD=your_password
# DB_CHARSET=utf8mb4
# DB_PARSE_TIME=true
# DB_LOC=Local

# Redis（必填：REDIS_ADDR）
REDIS_ADDR=
# REDIS_PASSWORD=
# REDIS_DB=0

# 支付宝开放平台（必填：ALIPAY_APP_ID / ALIPAY_PRIVATE_KEY）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=

# 高德地图（必填：AMAP_API_KEY）
AMAP_API_KEY=

# JWT（必填：JWT_SECRET）
JWT_SECRET=
# JWT_EXPIRE_HOURS=168

# 订单服务寻址（必填：ORDER_SERVICE_NAME / ORDER_SERVICE_BASE_URL 二选一）
# 模式一（推荐）：基于 Nacos 服务发现，仅填服务名
ORDER_SERVICE_NAME=
# ORDER_SERVICE_GROUP=
# 模式二：直连静态地址，格式如 http://host:port/api/v1
ORDER_SERVICE_BASE_URL=

# OpenTelemetry 可观测性
# OTLP 上报端点（gRPC），格式 host:port，如 localhost:4317；留空时用默认端点 localhost:4317
# 亦支持标准变量 OTEL_EXPORTER_OTLP_HEADERS（鉴权头等）
# OTEL_EXPORTER_OTLP_ENDPOINT=
# 日志上报协议：otlp（gRPC，复用上方端点）| otlphttp（HTTP）| none（仅本地输出，默认）
# 采集端不可达时自动回退本地输出，不阻断启动；日志与 trace 按 trace_id 关联
# OTEL_LOGS_EXPORTER=otlp

# Nacos：注册中心（服务发现）为主用途，统一配置中心为可选
# 配置中心仅在显式设置 NACOS_DATA_ID 时启用，不可达仅告警、不阻断启动，以 .env 兜底
# NACOS_IP=
# NACOS_PORT=8848
# NACOS_NAMESPACE_ID=
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_DATA_ID=
# NACOS_USERNAME=
# NACOS_PASSWORD=
# NACOS_TIMEOUT_MS=5000
# NACOS_LOG_LEVEL=info
