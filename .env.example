# 应用配置
PORT=8080
ENVIRONMENT=development
SERVICE_NAME=dextea-customer-api

# 数据库（MySQL）
# 连接串由代码根据以下拆分项自动拼接，无需手写 DSN。
# 若 DB_HOST 或 DB_NAME 留空，则不启用数据库（健康检查显示 db:disabled）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=dextea
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local

# Redis
# 填好 REDIS_ADDR 即启用 Redis；留空则不启用（健康检查显示 redis:disabled）。
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 支付宝登录（AppID 与应用私钥必填；公钥用于校验支付宝回包签名）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=

# JWT（HS256 签名密钥；生产环境务必设置为足够复杂的随机串）
JWT_SECRET=
JWT_EXPIRE_HOURS=168
