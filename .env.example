# 应用
# PORT=8080
# SERVICE_NAME=dextea-customer-api
# ENVIRONMENT=development

# MySQL
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
# DB_PORT=3306

# Redis
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 高德地图
AMAP_API_KEY=

# JWT
JWT_SECRET=
# JWT_EXPIRE_HOURS=168

# 订单服务
# 支持两种寻址模式，二选一（由 ORDER_SERVICE_MODE 切换，默认 nacos）：
#   static：填 ORDER_SERVICE_BASE_URL（固定地址）
#   nacos：填 ORDER_SERVICE_NAME，并配置下方 Nacos 连接参数
# ORDER_SERVICE_MODE=nacos
# ORDER_SERVICE_BASE_URL=
ORDER_SERVICE_NAME=dextea-trade

# 商品服务（gRPC）
# PRODUCT_SERVICE_MODE=nacos
# PRODUCT_SERVICE_BASE_URL=127.0.0.1:9090
PRODUCT_SERVICE_NAME=dextea-product
# PRODUCT_SERVICE_GROUP=DEFAULT_GROUP
# PRODUCT_BUSINESS_SERVICE_TOKEN=

# 门店服务（业务只读面，gRPC）
# STORE_SERVICE_MODE=nacos
# STORE_SERVICE_BASE_URL=127.0.0.1:9092
STORE_SERVICE_NAME=dextea-store-service
# STORE_SERVICE_GROUP=DEFAULT_GROUP
# STORE_BUSINESS_SERVICE_TOKEN=

# Nacos
NACOS_ENABLED=true
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_CLUSTER=DEFAULT
NACOS_DATA_ID=
NACOS_INSTANCE_IP=
NACOS_USERNAME=
NACOS_PASSWORD=
