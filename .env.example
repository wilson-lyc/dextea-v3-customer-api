# 应用配置
PORT=8080
ENVIRONMENT=development
SERVICE_NAME=dextea-customer-api

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=dextea
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=

# JWT
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# 高德地图
AMAP_API_KEY=

# 订单服务（交易端后台基础地址，如 http://host/api/v1；转发时自动剥离请求自身的 /api/v1 前缀）
ORDER_SERVICE_BASE_URL=

# OpenTelemetry 链路追踪上报地址（OTLP gRPC，如 http://localhost:4317）。
# 留空时按 OpenTelemetry 默认端点（localhost:4317）上报；仅支持标准
# OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_HEADERS 等环境变量配置。
OTEL_EXPORTER_OTLP_ENDPOINT=

# Nacos 配置中心（强依赖，缺失或不可达将拒绝启动）
# 服务地址与端口（必填）
NACOS_IP=
NACOS_PORT=8848
# 命名空间 ID，public 命名空间留空
NACOS_NAMESPACE_ID=
# 配置分组与 DataId（必填）
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=dextea-customer-api
# 服务端 API 鉴权（可选）
NACOS_USERNAME=
NACOS_PASSWORD=
# 请求超时(ms，默认 5000) 与日志级别(默认 info)
NACOS_TIMEOUT_MS=5000
NACOS_LOG_LEVEL=info