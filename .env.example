# 应用配置
PORT=8080
ENVIRONMENT=development
SERVICE_NAME=dextea-customer-api

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=dextea
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=

# JWT
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# 高德地图
AMAP_API_KEY=

# 订单服务寻址（二选一，推荐服务发现）
# 方式一（推荐）：Nacos 注册中心服务发现，动态获取订单服务实例地址，无需写死。
#   仅填 ORDER_SERVICE_NAME 即可（group 缺省使用下方 NACOS_GROUP）。
ORDER_SERVICE_NAME=
ORDER_SERVICE_GROUP=
# 方式二（兜底）：静态基础地址，如 http://host/api/v1；转发时自动剥离请求自身的 /api/v1 前缀。
#   服务发现解析失败时会回退到此地址；两者皆缺将无法启动。
ORDER_SERVICE_BASE_URL=

# OpenTelemetry 链路追踪上报地址（OTLP gRPC，如 http://localhost:4317）。
# 留空时按 OpenTelemetry 默认端点（localhost:4317）上报；仅支持标准
# OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_HEADERS 等环境变量配置。
OTEL_EXPORTER_OTLP_ENDPOINT=

# Nacos：本项目以「注册中心（服务发现）」为主要用途；「统一配置中心」为可选项。
# 配置中心仅在显式设置 NACOS_DATA_ID 时启用，不可达时仅告警、不阻断启动，
# .env 与默认值始终生效，可脱离 Nacos 配置中心独立运行。
# 注册中心（order 服务发现）仅需服务地址与端口；未配置 ORDER_SERVICE_NAME 时不连接。
# 服务地址与端口（注册/配置共用；启用任一 Nacos 能力时必填）
NACOS_IP=
NACOS_PORT=8848
# 命名空间 ID，public 命名空间留空
NACOS_NAMESPACE_ID=
# 统一配置中心分组与 DataId（可选；留空 = 不启用配置中心，纯 .env 模式）
NACOS_GROUP=DEFAULT_GROUP
NACOS_DATA_ID=
# 服务端 API 鉴权（可选）
NACOS_USERNAME=
NACOS_PASSWORD=
# 请求超时(ms，默认 5000) 与日志级别(默认 info)
NACOS_TIMEOUT_MS=5000
NACOS_LOG_LEVEL=info